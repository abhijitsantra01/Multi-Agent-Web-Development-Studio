# API Keys for the application
# Get a free Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
# Complex planning, research, and final HTML/CSS/JS assembly model
GEMINI_COMPLEX_MODEL=gemini-3.6-flash
# Lightweight sub-task and connector models
GEMINI_SIMPLE_MODEL=gemini-3.1-flash-lite
GEMINI_LITE_MODEL=gemini-3.1-flash-lite

# Alternatively, set your OpenRouter API key here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Nemotron generates all HTML/CSS, QA fixes, visual polish, later refinements,
# and automatically takes over if a Gemini task fails.
OPENROUTER_HTML_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ==========================================
# LangSmith Observability & Agent Tracing
# ==========================================
# Set to true to trace all agent workflows, sub-tasks, intent routing & LLM calls
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your_langsmith_api_key_here
# Note: Omit LANGSMITH_PROJECT when using LANGSMITH_AGENT_ID so traces route directly to the Agent address.
# LANGSMITH_PROJECT=gemini-orchestration-studio
LANGSMITH_AGENT_ID=agentic-orchestration
LANGSMITH_AGENT_ENVIRONMENT=local

